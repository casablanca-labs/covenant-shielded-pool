// APNT pool v1 record-keyed inbox. D is pushed as the redeem's first item:
// cm_0 (32) || packet_0 (16) || u64le(W) (8) || rk_0 (33).
// Settlement unlocking: <record index> <1> <redeem>.
// Refund unlocking: <signature> <0> <redeem>.
// ARCH-280's reviewed A source, with deployment constants assembled by the builder.
OP_SWAP
OP_IF
  //@check AUTH_CATEGORY
  <0> OP_UTXOTOKENCATEGORY @VERDICT_CATEGORY_PUSH@ OP_EQUALVERIFY
  //@end
  //@check AUTH_LOCK
  <0> OP_UTXOBYTECODE @SETTLEMENT_LOCK_PUSH@ OP_EQUALVERIFY
  //@end
  //@check CANON_SIZE
  OP_ACTIVEBYTECODE OP_SIZE OP_NIP @REDEEM_LENGTH_PUSH@ OP_NUMEQUALVERIFY
  //@end
  //@check CANON_HASH
  OP_ACTIVEBYTECODE OP_HASH256 OP_INPUTINDEX OP_UTXOBYTECODE <2> OP_SPLIT OP_NIP <32> OP_SPLIT OP_DROP OP_EQUALVERIFY
  //@end
  //@check TOKEN_FREE
  OP_INPUTINDEX OP_UTXOTOKENCATEGORY <0> OP_EQUALVERIFY
  //@end
  //@check OWN_VALUE
  OP_DUP <48> OP_SPLIT OP_NIP <8> OP_SPLIT OP_DROP 0x0100 OP_CAT OP_BIN2NUM OP_INPUTINDEX OP_UTXOVALUE OP_NUMEQUALVERIFY
  //@end
  //@check UNIQUE
  <0> <0>
  OP_BEGIN
    OP_DUP OP_UTXOBYTECODE OP_INPUTINDEX OP_UTXOBYTECODE OP_EQUAL
    OP_ROT OP_ADD OP_SWAP OP_1ADD
    OP_DUP OP_TXINPUTCOUNT OP_NUMEQUAL
  OP_UNTIL
  OP_DROP <1> OP_NUMEQUALVERIFY
  //@end
  <0> OP_INPUTBYTECODE
  <1> OP_SPLIT OP_SWAP
  //@check PUSH_FORM
  0x014d OP_EQUALVERIFY
  //@ablated OP_DROP
  //@end
  //@check STATEMENT_HASH
  OP_DUP <2> OP_SPLIT OP_SWAP 0x0100 OP_CAT OP_BIN2NUM OP_SPLIT OP_DROP OP_SHA256 <0> OP_UTXOTOKENCOMMITMENT OP_EQUALVERIFY
  //@end
  <90> OP_SPLIT OP_SWAP <88> OP_SPLIT OP_NIP 0x0100 OP_CAT OP_BIN2NUM
  //@check HINT_RANGE
  <3> OP_PICK <0> <2> OP_ROLL OP_WITHIN OP_VERIFY
  //@ablated OP_DROP
  //@end
  OP_ROT <314> OP_MUL OP_SPLIT OP_NIP <314> OP_SPLIT OP_DROP
  OP_SWAP <32> OP_SPLIT <16> OP_SPLIT <8> OP_SPLIT
  <4> OP_PICK <96> OP_SPLIT OP_NIP <33> OP_SPLIT OP_DROP
  //@check RECORD_RK
  OP_EQUALVERIFY
  //@ablated OP_2DROP
  //@end
  <3> OP_PICK <258> OP_SPLIT OP_NIP <8> OP_SPLIT OP_DROP
  //@check RECORD_DEPOSIT
  OP_EQUALVERIFY
  //@ablated OP_2DROP
  //@end
  <2> OP_PICK <226> OP_SPLIT OP_NIP <16> OP_SPLIT OP_DROP
  //@check RECORD_PACKET
  OP_EQUALVERIFY
  //@ablated OP_2DROP
  //@end
  OP_SWAP <162> OP_SPLIT OP_NIP <32> OP_SPLIT OP_DROP
  //@check RECORD_CM
  OP_EQUAL
  //@ablated OP_2DROP <1>
  //@end
OP_ELSE
  //@check REFUND_DELAY
  @REFUND_DELAY_PUSH@ OP_CHECKSEQUENCEVERIFY OP_DROP
  //@end
  <56> OP_SPLIT OP_NIP
  //@check REFUND_KEY
  OP_CHECKSIG
  //@ablated OP_2DROP <1>
  //@end
OP_ENDIF
